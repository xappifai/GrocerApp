next-env.d.ts


# =============================================================================
# TESTING
# =============================================================================
/coverage
/.nyc_output
/playwright-report
/test-results


# =============================================================================
# PACKAGE MANAGER LOCKS  (keep only the one your project uses)
# Uncomment whichever you DON'T use:
# =============================================================================
# yarn.lock          # uncomment if you use npm / pnpm
# package-lock.json  # uncomment if you use yarn / pnpm
# pnpm-lock.yaml     # uncomment if you use npm / yarn


