# ──────────────────────────────────────────────────────────
# GrocerApp — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=GrocerApp
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API ────────────────────────────────────────────────────
# Base URL for API calls (same origin in Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Mock Mode ──────────────────────────────────────────────
# Set to "true" to use mock data (no backend needed).
# Set to "false" (or remove) to hit real API routes.
NEXT_PUBLIC_USE_MOCK=true

# ── Database (Prisma + PostgreSQL) ─────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/grocerapp?schema=public

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Image Upload (optional) ────────────────────────────────
# Cloudinary (if using cloud image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Misc ───────────────────────────────────────────────────
NODE_ENV=development
